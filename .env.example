# Copy to .env.local (never committed) and fill in.
# Wishes from the "Make a wish" section are emailed via resend.com.
RESEND_API_KEY=
WISH_TO_EMAIL=you@example.com
# Optional; leave unset to use Resend's shared sender (delivers only to your Resend account email).
# WISH_FROM_EMAIL=Anniversary wishes <wishes@yourdomain.com>
